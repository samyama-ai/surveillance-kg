[0.606, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\r\n\u001b[1;33m(\u001b[0m\u001b[1;33mc:C\u001b[0m\u001b[33mountry\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:REPORTED\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mr:DiseaseReport\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:REPORT_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md:D\u001b[0m\u001b[33misease\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE \u001b[0m\r\n\u001b[33md.name = \u001b[0m\u001b[33m\"Number of reported cases of cholera\"\u001b[0m\u001b[33m RETURN c.name AS country, \u001b[0m\r\n\u001b[1;33msum\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mr.value\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS cases ORDER BY cases DESC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.011, "o", "  \u001b[32m→\u001b[0m countries with most reported cholera cases: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Haiti'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m41421.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'Democratic Republic of the Congo'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m28093.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Yemen'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m15751.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Somalia'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;36m15619.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'United Republic of Tanzania'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m11360.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
