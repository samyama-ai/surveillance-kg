[1.405, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mc:C\u001b[0m\u001b[33mountry\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:HAS_COVERAGE\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mv:VaccineCoverage\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE v.antigen\u001b[0m\r\n\u001b[33m= \u001b[0m\u001b[33m\"DTP3 immunization coverage \u001b[0m\u001b[33m(\u001b[0m\u001b[33m%\u001b[0m\u001b[33m)\u001b[0m\u001b[33m\"\u001b[0m\u001b[33m AND v.coverage_pct < \u001b[0m\u001b[1;33m50.0\u001b[0m\u001b[33m RETURN c.name AS \u001b[0m\r\n\u001b[33mcountry, \u001b[0m\u001b[1;33mmin\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mv.coverage_pct\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS lowest_dtp3_pct ORDER BY lowest_dtp3_pct ASC \u001b[0m\r\n\u001b[33mLIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.003, "o", "  \u001b[32m→\u001b[0m most under-vaccinated populations: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Ukraine'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m19.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Papua New Guinea'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;36m35.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Central African Republic'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m38.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Chad'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m41.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Samoa'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m44.0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
