[0.605, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md:D\u001b[0m\u001b[33misease\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m<-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:REPORT_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mr:DiseaseReport\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN d.name AS \u001b[0m\r\n\u001b[33mdisease, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mr\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS reports ORDER BY reports DESC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.002, "o", "  \u001b[32m→\u001b[0m most-reported indicators: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Tuberculosis incidence \u001b[0m\u001b[1;32m(\u001b[0m\u001b[1;32mper 100 000 \u001b[0m\r\n\u001b[1;32mpopulation\u001b[0m\u001b[1;32m)\u001b[0m\u001b[1;32m'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m832\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'TB deaths \u001b[0m\u001b[1;32m(\u001b[0m\u001b[1;32mexcluding HIV+TB\u001b[0m\u001b[1;32m)\u001b[0m\u001b[1;32m'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m752\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Reported cases of \u001b[0m\r\n\u001b[1;32mdengue fever'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m726\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Number of reported cases of yellow fever'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m716\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'Estimated number of people living with HIV'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m624\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
